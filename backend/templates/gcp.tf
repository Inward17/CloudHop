# Generated by Cloudhop: one VM running Compose, with a private bucket for moving data.
terraform {
  backend "gcs" {}
  required_providers {
    google = { source = "hashicorp/google", version = "~> 6.0" }
    random = { source = "hashicorp/random", version = "~> 3.0" }
  }
}

variable "name" { type = string }
variable "region" { type = string }
variable "project" { type = string }

provider "google" {
  project = var.project
  region  = var.region
}

locals { zone = "${var.region}-a" }

resource "random_password" "db" {
  length  = 32
  special = false
}

resource "google_storage_bucket" "data" {
  name                        = "${var.name}-${var.project}-data"
  location                    = var.region
  force_destroy               = true
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"
}

resource "google_service_account" "vm" {
  account_id = "${substr(var.name, 0, 27)}-vm"
}

resource "google_storage_bucket_iam_member" "vm" {
  bucket = google_storage_bucket.data.name
  role   = "roles/storage.objectAdmin"
  member = "serviceAccount:${google_service_account.vm.email}"
}

resource "google_compute_firewall" "web" {
  name          = "${var.name}-web"
  network       = "default"
  source_ranges = ["0.0.0.0/0"]
  target_tags   = [var.name]
  allow {
    protocol = "tcp"
    ports    = ["80", "8081-8090"]
  }
}

# SSH only through Google's IAP tunnel range, never the open internet.
resource "google_compute_firewall" "iap" {
  name          = "${var.name}-iap"
  network       = "default"
  source_ranges = ["35.235.240.0/20"]
  target_tags   = [var.name]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_address" "vm" {
  name = "${var.name}-ip"
}

resource "google_compute_instance" "vm" {
  name         = "${var.name}-vm"
  machine_type = "e2-small"
  zone         = local.zone
  tags         = [var.name]
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      size  = 20
      type  = "pd-balanced"
    }
  }
  network_interface {
    network = "default"
    access_config { nat_ip = google_compute_address.vm.address }
  }
  service_account {
    email  = google_service_account.vm.email
    scopes = ["cloud-platform"]
  }
  metadata = { enable-oslogin = "TRUE" }
  metadata_startup_script = <<-EOT
    #!/bin/bash
    set -e
    curl -fsSL https://get.docker.com | sh
    mkdir -p /opt/cloudhop
    touch /opt/cloudhop/ready
  EOT
}

output "public_ip" { value = google_compute_address.vm.address }
output "zone" { value = local.zone }
output "data_bucket" { value = google_storage_bucket.data.name }
output "db_password" {
  value     = random_password.db.result
  sensitive = true
}
