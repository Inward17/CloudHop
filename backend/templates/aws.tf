# Generated by Cloudhop: one VM running Compose, with a private bucket for moving data.
terraform {
  backend "s3" {}
  required_providers {
    aws    = { source = "hashicorp/aws", version = "~> 5.0" }
    random = { source = "hashicorp/random", version = "~> 3.0" }
  }
}

variable "name" { type = string }
variable "region" { type = string }

provider "aws" { region = var.region }

data "aws_caller_identity" "me" {}
data "aws_vpc" "default" { default = true }
data "aws_ssm_parameter" "ami" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
}

resource "random_password" "db" {
  length  = 32
  special = false
}

resource "aws_s3_bucket" "data" {
  bucket        = "${var.name}-${data.aws_caller_identity.me.account_id}-data"
  force_destroy = true
}

resource "aws_s3_bucket_public_access_block" "data" {
  bucket                  = aws_s3_bucket.data.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_iam_role" "vm" {
  name = "${var.name}-vm"
  assume_role_policy = jsonencode({
    Version   = "2012-10-17"
    Statement = [{ Effect = "Allow", Action = "sts:AssumeRole", Principal = { Service = "ec2.amazonaws.com" } }]
  })
}

resource "aws_iam_role_policy_attachment" "ssm" {
  role       = aws_iam_role.vm.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

resource "aws_iam_role_policy" "bucket" {
  role = aws_iam_role.vm.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["s3:GetObject", "s3:PutObject", "s3:ListBucket"]
      Resource = [aws_s3_bucket.data.arn, "${aws_s3_bucket.data.arn}/*"]
    }]
  })
}

resource "aws_iam_instance_profile" "vm" {
  name = "${var.name}-vm"
  role = aws_iam_role.vm.name
}

resource "aws_security_group" "vm" {
  name   = "${var.name}-vm"
  vpc_id = data.aws_vpc.default.id
  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  ingress {
    from_port   = 8081
    to_port     = 8090
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "vm" {
  ami                    = data.aws_ssm_parameter.ami.value
  instance_type          = "t3.small"
  iam_instance_profile   = aws_iam_instance_profile.vm.name
  vpc_security_group_ids = [aws_security_group.vm.id]
  root_block_device {
    volume_size = 20
    volume_type = "gp3"
  }
  user_data = <<-EOT
    #!/bin/bash
    set -e
    dnf install -y docker
    systemctl enable --now docker
    mkdir -p /usr/libexec/docker/cli-plugins
    curl -fsSL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 -o /usr/libexec/docker/cli-plugins/docker-compose
    chmod +x /usr/libexec/docker/cli-plugins/docker-compose
    mkdir -p /opt/cloudhop
    touch /opt/cloudhop/ready
  EOT
  tags = { Name = "${var.name}-vm" }
}

resource "aws_eip" "vm" {
  instance = aws_instance.vm.id
  domain   = "vpc"
}

output "public_ip" { value = aws_eip.vm.public_ip }
output "instance_id" { value = aws_instance.vm.id }
output "data_bucket" { value = aws_s3_bucket.data.bucket }
output "db_password" {
  value     = random_password.db.result
  sensitive = true
}
